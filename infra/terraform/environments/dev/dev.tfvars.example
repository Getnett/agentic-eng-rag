project_id = "replace-with-development-project-id"
region     = "europe-west1"

# Model selection is non-secret and remains configurable for regional availability.
vertex_generation_model = "gemini-2.5-flash-lite"

# Immutable GitHub IDs protect workload federation from repository/owner renames.
github_repository          = "OWNER/REPOSITORY"
github_repository_id       = "NUMERIC_REPOSITORY_ID"
github_repository_owner_id = "NUMERIC_OWNER_ID"

# Keep safeguards enabled for ordinary plans and applies.
deletion_protection      = true
allow_destructive_cleanup = false

# Leave unset for the first apply. After pushing the migration image, use the
# Terraform-managed repository and an immutable digest.
# migration_image = "europe-west1-docker.pkg.dev/PROJECT/rag-dev-images/migrations@sha256:DIGEST"

# After adding the documented Supabase verification JSON to the Terraform-managed
# application-auth-secret, pin its immutable numeric version here.
# supabase_auth_secret_version = "1"

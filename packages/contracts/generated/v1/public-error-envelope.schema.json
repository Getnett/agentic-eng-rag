{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rag-support:contracts:v1:public-error-envelope.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "$ref": "#/$defs/__schema0"
    },
    "request_id": {
      "$ref": "#/$defs/__schema1"
    },
    "error": {
      "$ref": "#/$defs/__schema2"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "error"
  ],
  "additionalProperties": false,
  "title": "Public error envelope",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "v1"
    },
    "__schema1": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "title": "Request ID"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "AUTHENTICATION_REQUIRED",
            "UNAUTHORIZED_WIDGET",
            "ORIGIN_NOT_ALLOWED",
            "RATE_LIMITED",
            "SERVICE_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    }
  }
}

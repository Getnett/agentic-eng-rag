{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rag-support:contracts:v1:internal-trace-context.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "$ref": "#/$defs/__schema0"
    },
    "request_id": {
      "$ref": "#/$defs/__schema1"
    },
    "conversation_id": {
      "$ref": "#/$defs/__schema2"
    },
    "model_profile_id": {
      "$ref": "#/$defs/__schema3"
    },
    "source_version_ids": {
      "$ref": "#/$defs/__schema4"
    },
    "retrieved_chunk_ids": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "conversation_id",
    "model_profile_id",
    "source_version_ids",
    "retrieved_chunk_ids"
  ],
  "additionalProperties": false,
  "title": "Internal trace context",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "v1"
    },
    "__schema1": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "title": "Request ID"
    },
    "__schema2": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "title": "Conversation ID"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema3": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "title": "Model profile ID"
    },
    "__schema4": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "__schema5": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "title": "Source version ID"
    },
    "__schema6": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "__schema7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "title": "Chunk ID"
    }
  }
}

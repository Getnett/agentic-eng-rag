{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rag-support:contracts:v1:chat-sse-event.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/__schema0"
    },
    {
      "$ref": "#/$defs/__schema4"
    },
    {
      "$ref": "#/$defs/__schema5"
    },
    {
      "$ref": "#/$defs/__schema6"
    },
    {
      "$ref": "#/$defs/__schema7"
    }
  ],
  "title": "Normalized chat SSE event",
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "answer.delta"
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "data": {
          "type": "object",
          "properties": {
            "contract_version": {
              "$ref": "#/$defs/__schema2"
            },
            "request_id": {
              "$ref": "#/$defs/__schema3"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "required": [
            "contract_version",
            "request_id",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event",
        "id",
        "data"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "title": "SSE event ID"
    },
    "__schema2": {
      "type": "string",
      "const": "v1"
    },
    "__schema3": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "title": "Request ID"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "citation"
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "data": {
          "type": "object",
          "properties": {
            "contract_version": {
              "$ref": "#/$defs/__schema2"
            },
            "request_id": {
              "$ref": "#/$defs/__schema3"
            },
            "citation_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "title": "Citation ID"
            },
            "document_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "title": "Document ID"
            },
            "document_title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "source_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "page_number": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "heading": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "contract_version",
            "request_id",
            "citation_id",
            "document_id",
            "document_title",
            "source_url",
            "page_number",
            "heading"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event",
        "id",
        "data"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "abstention"
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "data": {
          "type": "object",
          "properties": {
            "contract_version": {
              "$ref": "#/$defs/__schema2"
            },
            "request_id": {
              "$ref": "#/$defs/__schema3"
            },
            "reason": {
              "type": "string",
              "const": "insufficient_evidence"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "handoff": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "url": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "uri"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "email": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "email",
                          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "label",
                    "url",
                    "email"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "contract_version",
            "request_id",
            "reason",
            "message",
            "handoff"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event",
        "id",
        "data"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "complete"
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "data": {
          "type": "object",
          "properties": {
            "contract_version": {
              "$ref": "#/$defs/__schema2"
            },
            "request_id": {
              "$ref": "#/$defs/__schema3"
            },
            "status": {
              "type": "string",
              "enum": [
                "answered",
                "abstained"
              ]
            },
            "conversation_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "title": "Conversation ID"
            },
            "message_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "title": "Message ID"
            }
          },
          "required": [
            "contract_version",
            "request_id",
            "status",
            "conversation_id",
            "message_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event",
        "id",
        "data"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "const": "error"
        },
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "data": {
          "type": "object",
          "properties": {
            "contract_version": {
              "$ref": "#/$defs/__schema2"
            },
            "request_id": {
              "$ref": "#/$defs/__schema3"
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "INVALID_REQUEST",
                    "UNAUTHORIZED_WIDGET",
                    "ORIGIN_NOT_ALLOWED",
                    "RATE_LIMITED",
                    "SERVICE_UNAVAILABLE",
                    "INTERNAL_ERROR"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "contract_version",
            "request_id",
            "error"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "event",
        "id",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
